# ─────────────────────────────────────────────────────────────────────────────
# Shield Server — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3001

# Firebase Firestore
FIREBASE_PROJECT_ID=shield-419e1
# Authenticate with Application Default Credentials or set this to a service-account JSON file path.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins for the mobile API client
# For local Expo dev, add your LAN IP or use * for dev-only
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=debug

# Google OAuth — web client ID from https://console.cloud.google.com/apis/credentials
# Leave empty to disable "Sign in with Google" on the server.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Email OTP — Resend API (create an API key at https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Shield <login@your-verified-domain.com>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# Encryption key for sensitive fields (AES-256-GCM) — 64 hex chars = 32 bytes
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX
