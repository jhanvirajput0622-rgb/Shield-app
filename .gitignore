
# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Environment files — NEVER commit secrets
.env
.env.local
.env.*.local
server/.env

# Build artefacts
dist/
dist-test/
build/
.expo/
static-build/
*.tsbuildinfo

# Native projects are generated by EAS prebuild from app.json
/android/
/artifacts/*/android/
/artifacts/*/ios/
.gradle/
local.properties
*.iml

# Firebase emulator/CLI logs
.firebase/logs/

# Local export/backup archives
*.tar.gz

# Firebase emulator artefacts — regenerated by `server/test/run.sh`
# (emulators:exec writes a debug log next to whichever config it was given)
firestore-debug.log
ui-debug.log
firebase-debug.log
firebase-debug.*.log

# Firebase Data Connect local cache
dataconnect/.dataconnect/

# Credentials
atlas-credentials.env
*.pem
*.key
*.cert
