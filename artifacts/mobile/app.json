{
  "expo": {
    "name": "Shield",
    "slug": "mobile",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "shield",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Shield uses the camera to scan QR codes and check links for phishing threats.",
        "NSLocationWhenInUseUsageDescription": "Shield uses your location for Anti-Theft device tracking. Location data is encrypted end-to-end before leaving your device.",
        "NSFaceIDUsageDescription": "Shield uses Face ID to confirm sensitive actions such as remote device wipe.",
        "NSUserNotificationsUsageDescription": "Shield sends alerts when it detects threats — phishing links, high-risk apps, or suspicious network activity."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Shield uses the camera to scan QR codes and check links for phishing threats."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2FE6C3",
          "sounds": []
        }
      ],
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "04053d7e-3b49-4330-8f3e-493d30e7c654"
      }
    },
    "owner": "jbaraiya2204"
  }
}
