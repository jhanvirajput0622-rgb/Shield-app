{
  "expo": {
    "name": "Shield",
    "slug": "shield-app",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shield",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/05ae3d84-d7d2-454d-ad14-2b42819c4b43",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jbaraiya2204.shield",
      "infoPlist": {
        "NSCameraUsageDescription": "Shield uses the camera to scan QR codes and check links for phishing threats.",
        "NSLocationWhenInUseUsageDescription": "Shield uses your location for Anti-Theft device tracking. Location data is encrypted end-to-end before leaving your device.",
        "NSFaceIDUsageDescription": "Shield uses Face ID to confirm sensitive actions such as remote device wipe.",
        "NSUserNotificationsUsageDescription": "Shield sends alerts when it detects threats — phishing links, high-risk apps, or suspicious network activity."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.jbaraiya2204.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-dev-client",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Shield uses the camera to scan QR codes and check links for phishing threats."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2FE6C3",
          "sounds": []
        }
      ],
      "expo-local-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "05ae3d84-d7d2-454d-ad14-2b42819c4b43"
      }
    },
    "owner": "jbaraiya2204"
  }
}
