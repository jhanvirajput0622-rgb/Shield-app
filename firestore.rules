rules_version = '2';

// Shield accesses Firestore exclusively through the Express API using the
// Firebase Admin SDK (server/src/config/firestore.ts). Admin SDK bypasses these
// rules, so this file exists to guarantee that *no* client path can reach the
// database directly.
//
// The mobile client (artifacts/mobile) talks exclusively to the Shield API over
// HTTPS and authenticates with the app's own JWT (server/src/middleware/auth.middleware.ts).
// It never initialises the Firestore client SDK -- artifacts/mobile/lib/firebase.ts is
// dead code and must stay unused. See docs/FIREBASE.md.
//
// Consequence: there is no legitimate client read or write here. Deny everything.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
